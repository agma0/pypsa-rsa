#!/bin/bash --login
# IMPORTANT: Run this script DIRECTLY on the frontend (NOT via sbatch)!
# Usage from frontend:
#   tmux new -s pypsa        (start a persistent session)
#   bash run_head.job        (inside tmux)
#
# Submitting via sbatch causes snakemake to run on a compute node, which:
#   1. Creates a Gurobi session on the compute node (counts against your WLS license)
#   2. Gets cancelled when the head SLURM job hits its time limit
#   3. Is explicitly warned against by snakemake itself

export GRB_LICENSE_FILE=/home/users/a/agma/gurobi.lic

cd /beegfs/scratch/agma/pypsa-rsa
mkdir -p logs

MAMBA_EXE='/beegfs/home/users/a/agma/.pixi/envs/micromamba/bin/micromamba'
MAMBA_ROOT='/beegfs/home/users/a/agma/.local/share/mamba'
PYPSA_ENV='/beegfs/home/users/a/agma/.pixi/envs/pypsa-rsa'

$MAMBA_EXE run --root-prefix $MAMBA_ROOT -p $PYPSA_ENV \
    snakemake solve_all \
    --executor slurm \
    --default-resources \
        "slurm_partition=standard" \
        "mem_mb=16000" \
        "runtime=120" \
        "slurm_mail_type=END,FAIL" \
        "slurm_mail_user=agatha.majcher@tu-berlin.de" \
    --resources solver_slots=1 \
    --jobs 16 \
    --latency-wait 120 \
    --rerun-incomplete \
    2>&1 | tee logs/snakemake_head_$(date +%Y%m%dT%H%M%S).log
