#!/bin/bash --login
#SBATCH --job-name=pypsa_p0
#SBATCH --output=logs/slurm_p0_%j.out
#SBATCH --time=8:00:00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=8
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=agatha.majcher@tu-berlin.de

export GRB_LICENSE_FILE=/home/users/a/agma/gurobi.lic

cd /beegfs/scratch/agma/pypsa-rsa

# Hourly status loop (runs in background)
while true; do
    sleep 3600
    echo "--- HOURLY UPDATE: $(date) --- still running ---"
done &
LOOP_PID=$!

MAMBA_EXE='/beegfs/home/users/a/agma/.pixi/envs/micromamba/bin/micromamba'
MAMBA_ROOT='/beegfs/home/users/a/agma/.local/share/mamba'
PYPSA_ENV='/beegfs/home/users/a/agma/.pixi/envs/pypsa-rsa'

$MAMBA_EXE run --root-prefix $MAMBA_ROOT -p $PYPSA_ENV \
    snakemake solve_all -j 4 -F --resources solver_slots=2

kill $LOOP_PID 2>/dev/null
